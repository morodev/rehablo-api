# Server
NODE_ENV=development
PORT=3000

# Database (single Postgres instance, "public" schema for global/tenant data,
# one dynamic schema per tenant "rehablo_<tenantId>" for tenant-scoped business data)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rehablo
DB_SSL=false
DATABASE_MIGRATION_PHASE=managed
MIGRATION_CONCURRENCY=2
MIGRATION_STATEMENT_TIMEOUT_MS=120000
# Legacy sync is available only in the ordered bridge rollout; managed ignores this flag.
TENANT_SCHEMA_SYNC=off

# Auth
JWT_SECRET=change-me-please-use-a-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_GRACE_SECONDS=60
PATIENT_PORTAL_INVITE_TTL_HOURS=72

# Stripe
STRIPE_SECRET_KEY=

# Email (SMTP)
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_AUTH_USER=
EMAIL_AUTH_PASS=
# Opzionale: deve essere un mittente autorizzato dal provider. Default: EMAIL_AUTH_USER.
EMAIL_FROM=
# Generate once with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Keep the private key stable across deploys; configure both for push notifications.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# Set false only to temporarily pause background delivery during maintenance.
REMINDER_EXTERNAL_DELIVERY_ENABLED=true
# URL pubblico del frontend, usato per i link inviati ai pazienti (invito al portale, fattura).
# In produzione DEVE essere un dominio pubblico: su WhatsApp un indirizzo come localhost o un IP
# non diventa nemmeno cliccabile e il paziente non può aprire il documento.
EMAIL_DOMAIN=http://localhost:4200

# Opzionale: durata del link con cui la fattura viene consegnata al paziente. Default: 720 (30 giorni).
INVOICE_SHARE_TTL_HOURS=720

# CORS
CORS_ORIGIN=*

# ============================================================================
# Trasmissione fiscale (SDI / Sistema TS) — vedi docs/fiscal-integration-setup.md
# ============================================================================
# Interruttore generale. false (DEFAULT) = SOLO gateway MOCK/sandbox: nessun dato
# reale viene trasmesso a SDI o Sistema TS. Portare a true solo dopo aver configurato
# provider/credenziali e validato i tracciati ufficiali.
FISCAL_TRANSMISSION_ENABLED=false

# --- Canale SDI (fattura elettronica) ---
# MOCK = sandbox deterministica. PROVIDER = adapter di un intermediario (richiede endpoint + API key).
FISCAL_SDI_PROVIDER=MOCK
FISCAL_SDI_ENDPOINT=
FISCAL_SDI_API_KEY=

# --- Canale Sistema TS diretto (credenziali dello STUDIO, dal portale Sistema TS) ---
# In multi-tenant vanno spostate su impostazioni per-tenant cifrate: questi valori globali
# servono per un singolo tenant pilota. FISCAL_STS_LIVE=true abilita l'invio reale.
FISCAL_STS_ENDPOINT=
FISCAL_STS_USERNAME=
FISCAL_STS_PASSWORD=
FISCAL_STS_PINCODE=
FISCAL_STS_LIVE=false

